{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "easybot-business-fixture",
  "title": "Tester business fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "speakingStyle",
    "openingHint",
    "fullKnowledge",
    "disclosurePolicy",
    "customerIntentions",
    "editLoop",
    "expectedApprovedCore",
    "corrections"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string" },
    "speakingStyle": { "type": "string" },
    "openingHint": { "type": "string" },
    "fullKnowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "whatWeDo",
        "services",
        "hours",
        "locationOrArea",
        "tone",
        "pricingNotes",
        "policies",
        "optionalFacts",
        "explicitUnknowns",
        "hiddenNeverDisclose"
      ],
      "properties": {
        "name": { "type": "string" },
        "whatWeDo": { "type": "string" },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "price"],
            "properties": {
              "name": { "type": "string" },
              "price": { "type": "string" },
              "notes": { "type": ["string", "null"] }
            }
          }
        },
        "hours": { "type": "string" },
        "locationOrArea": { "type": "string" },
        "tone": { "type": "string" },
        "pricingNotes": { "type": "array", "items": { "type": "string" } },
        "policies": { "type": "object", "additionalProperties": { "type": "string" } },
        "optionalFacts": { "type": "array", "items": { "type": "string" } },
        "informationToCollect": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional. Items the Business Bot should ask the customer for. Owner reveals only when Builder asks about collecting/asking the customer."
        },
        "explicitUnknowns": { "type": "array", "items": { "type": "string" } },
        "hiddenNeverDisclose": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tester-only secrets; must never appear in owner messages or approved config"
        }
      }
    },
    "disclosurePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxFactsPerTurn", "preferAnswerBuilderQuestion", "neverDumpOptional", "neverDiscloseHidden"],
      "properties": {
        "maxFactsPerTurn": { "type": "integer", "minimum": 1, "maximum": 5 },
        "preferAnswerBuilderQuestion": { "type": "boolean" },
        "neverDumpOptional": { "type": "boolean" },
        "neverDiscloseHidden": { "type": "boolean" }
      }
    },
    "customerIntentions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "kind", "expectHint"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": [
              "normal",
              "unknown_policy",
              "ambiguous_unit",
              "leading_claim",
              "override",
              "unsupported_action"
            ]
          },
          "expectHint": { "type": "string" },
          "phase": {
            "type": "string",
            "enum": ["initial", "after_edit"],
            "default": "initial"
          }
        }
      }
    },
    "editLoop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pendingMessage", "approveMessage", "postApproveServicesMustMatch", "pendingMustNotLiveHint", "afterApproveHint"],
      "properties": {
        "pendingMessage": { "type": "string" },
        "approveMessage": { "type": "string" },
        "postApproveServicesMustMatch": { "type": "string" },
        "pendingMustNotLiveHint": { "type": "string" },
        "afterApproveHint": { "type": "string" },
        "pendingProbeQuestion": { "type": "string" },
        "afterApproveQuestion": { "type": "string" }
      }
    },
    "expectedApprovedCore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "whatWeDo", "serviceNameSubstrings", "priceSubstrings", "unknownSubstrings"],
      "properties": {
        "name": { "type": "string" },
        "whatWeDo": { "type": "string" },
        "serviceNameSubstrings": { "type": "array", "items": { "type": "string" } },
        "priceSubstrings": { "type": "array", "items": { "type": "string" } },
        "unknownSubstrings": { "type": "array", "items": { "type": "string" } },
        "mustNotContain": { "type": "array", "items": { "type": "string" } }
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["when", "message"],
        "properties": {
          "when": {
            "type": "string",
            "enum": ["invention", "missing_unknown", "stale_fact", "generic"]
          },
          "message": { "type": "string" }
        }
      }
    }
  }
}
