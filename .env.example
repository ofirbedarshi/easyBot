# OpenAI — paste your key after the equals sign (no quotes)
OPENAI_API_KEY=

# Model used by the builder agent and Flowise ChatOpenAI node
OPENAI_MODEL=gpt-4o-mini

# Tester judge (separate evaluation call). JUDGE_MODE=stub|real
# Default: real when OPENAI_API_KEY is set, else stub. Stub never makes paid calls.
# JUDGE_MODE=stub
# Optional override model for judge only (same provider/key):
# JUDGE_MODEL=gpt-4o-mini

# Flowise local instance
FLOWISE_URL=http://localhost:3000
# Optional: set if your Flowise instance requires API key auth
FLOWISE_API_KEY=

# App UI
PORT=3080
