# OpenAI — paste your key after the equals sign (no quotes)
OPENAI_API_KEY=

# Model used by the builder agent and Flowise ChatOpenAI node
OPENAI_MODEL=gpt-4o-mini

# Flowise instance (local Docker or Render service URL)
FLOWISE_URL=http://localhost:3000
# Optional: set if your Flowise instance requires API key auth
FLOWISE_API_KEY=
# Optional: pending sync after Approve when Flowise is cold (defaults shown)
# FLOWISE_PING_TIMEOUT_MS=5000
# FLOWISE_WAKE_TIMEOUT_MS=120000
# FLOWISE_SYNC_POLL_MS=15000
# FLOWISE_SYNC_MAX_WAIT_MS=300000

# App UI / server
PORT=3080
# production | development
NODE_ENV=development
# Exact public HTTPS origin Twilio calls (no trailing slash). Required for signature checks.
PUBLIC_BASE_URL=

# Supabase (project easybot) — server-side only; never expose service role to the browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional anon key (not used by the app webhook path)
SUPABASE_ANON_KEY=

# Twilio WhatsApp — set in Render / local env; never commit real values
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# e.g. whatsapp:+14155238886 (Sandbox) or your approved WhatsApp sender
TWILIO_WHATSAPP_FROM=
# Set to 1 in unit tests to skip Messages API outbound
# TWILIO_SKIP_OUTBOUND=1
# Inbound worker: ON only with TWILIO_AUTH_TOKEN, and OFF when FLOWISE_URL is local
# while PUBLIC_BASE_URL is remote (stops local UI stealing Render WhatsApp jobs).
# DISABLE_INBOUND_WORKER=1
# ENABLE_INBOUND_WORKER=1


# Demo usage caps (personal WhatsApp demo)
DEMO_MAX_MSG_CHARS=2000
DEMO_MAX_MSGS_PER_SENDER_PER_HOUR=30
DEMO_MAX_MSGS_PER_SENDER_PER_DAY=100

# Inbound worker poll interval (ms)
# WORKER_POLL_MS=500
